    m10: + <isa> inter {}
    m11: + <isa> inter {}
    m12: + <isa> inter {}
    m13: + <isa> inter {}
    m14: + <isa> product {}

    @u0 { (+m0, -m1, -m2); }
    @u1 { (+m0, -m3, -m4); }
    @u2 { (+m0, -m5, -m6); }
    @u3 { (+m0, -m7, -m8); }
