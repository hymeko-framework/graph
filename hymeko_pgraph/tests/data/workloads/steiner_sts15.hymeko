steiner_sts15 {
    @"meta_pgraph.hymeko";
    using pgraph.raw as raw;
    using pgraph.product as product;
    using pgraph.intermediate as inter;
    using pgraph.process as process;
}

body {
    m0: + <isa> raw {}
    m1: + <isa> inter {}
    m2: + <isa> inter {}
    m3: + <isa> inter {}
    m4: + <isa> inter {}
    m5: + <isa> inter {}
    m6: + <isa> inter {}
    m7: + <isa> inter {}
