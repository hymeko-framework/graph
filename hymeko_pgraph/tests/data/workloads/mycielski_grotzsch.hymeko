mycielski_grotzsch {
    @"meta_pgraph.hymeko";
    using pgraph.raw as raw;
    using pgraph.product as product;
    using pgraph.intermediate as inter;
    using pgraph.process as process;
}

body {
    m0: + <isa> raw {}
    m1: + <isa> inter {}
    m2: + <isa> inter {}
    m3: + <isa> inter {}
    m4: + <isa> inter {}
    m5: + <isa> inter {}
    m6: + <isa> inter {}
    m7: + <isa> inter {}
    m8: + <isa> inter {}
    m9: + <isa> inter {}
    m10: + <isa> product {}

    @u0 { (+m0, -m1); }
    @u1 { (+m5, -m1); }
    @u2 { (+m6, -m0); }
    @u3 { (+m1, -m2); }
    @u4 { (+m6, -m2); }
    @u5 { (+m7, -m1); }
    @u6 { (+m2, -m3); }
    @u7 { (+m7, -m3); }
    @u8 { (+m8, -m2); }
    @u9 { (+m3, -m4); }
    @u10 { (+m8, -m4); }
    @u11 { (+m9, -m3); }
    @u12 { (+m4, -m0); }
    @u13 { (+m9, -m0); }
    @u14 { (+m5, -m4); }
    @u15 { (+m5, -m10); }
    @u16 { (+m6, -m10); }
    @u17 { (+m7, -m10); }
    @u18 { (+m8, -m10); }
    @u19 { (+m9, -m10); }
}
