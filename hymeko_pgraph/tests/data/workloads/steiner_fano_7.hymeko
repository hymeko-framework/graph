steiner_fano_7 {
    @"meta_pgraph.hymeko";
    using pgraph.raw as raw;
    using pgraph.product as product;
    using pgraph.intermediate as inter;
    using pgraph.process as process;
}

body {
    m0: + <isa> raw {}
    m1: + <isa> inter {}
    m2: + <isa> inter {}
    m3: + <isa> inter {}
    m4: + <isa> inter {}
    m5: + <isa> inter {}
    m6: + <isa> product {}

    @u0 { (+m0, -m1, -m2); }
    @u1 { (+m0, -m3, -m4); }
    @u2 { (+m0, -m5, -m6); }
    @u3 { (+m1, -m3, -m5); }
    @u4 { (+m1, -m4, -m6); }
    @u5 { (+m2, -m3, -m6); }
    @u6 { (+m2, -m4, -m5); }
}
