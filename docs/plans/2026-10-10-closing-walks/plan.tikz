\begin{center}
\begin{tikzpicture}[node distance=1.4cm, every node/.style={draw, rounded corners, font=\small, align=center}]
\node (g) {SignedGraph\\visible edges};
\node (p) [right=of g] {query pairs\\$(u,v)$};
\node (e) [below=of $(g)!0.5!(p)$] {enumerate\_closing\_walks\\paths $u\to\dots\to v$, $L\ge2$};
\node (r) [below=of e] {ClosingWalks\\pair\_offsets, member signs};
\node (n) [below=of r] {Nagare: admission ``closing''\\query incidence = pair\_offsets};
\draw[-Stealth] (g) -- (e); \draw[-Stealth] (p) -- (e); \draw[-Stealth] (e) -- (r); \draw[-Stealth] (r) -- (n);
\end{tikzpicture}
\end{center}
