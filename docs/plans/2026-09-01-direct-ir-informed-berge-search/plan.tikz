\node (bounds) [left=8mm of runner] {Hop / Max heuristics\\declared contracts};
\node (protocol) [right=8mm of case] {Shared evidence protocol\\cheap sample / strong verification};
\node (rows) [below=of protocol] {Typed TSV rows\\preserved keys and units};
\draw[->] (case)--(runner);\draw[->] (bounds)--(runner);\draw[->] (protocol)--(case);\draw[->] (protocol)--(rows);
\end{tikzpicture}


